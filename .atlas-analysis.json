  "keyFeatures": [
    "IAP tunnel proxy for secure GCP resource access without public exposure",
    "Helm provider wrapper that routes deployments through IAP-authenticated proxies",
    "Kubernetes provider wrapper with transparent IAP proxy integration",
    "Automatic tunnel lifecycle management (start/stop with Terraform apply/destroy)",
    "Keep-alive data source to maintain tunnel connections during long-running operations",
    "Schema combining utilities for composing multiple Terraform provider schemas",
    "Support for GCP service account impersonation and token-based authentication"
  ],
  "publicApiSurface": [
    "resource: iap_tunnel_proxy (project, zone, instance, interface, remote_port → proxy_url)",
    "data source: iap_tunnel_keep_alive (timeout, proxy_url → timed_out)",
    "provider: iap (wraps Google provider + IAP tunnel resources)",
    "provider: helmproxy (wraps Helm + Google providers with IAP tunnel)",
    "provider: kubeproxy (wraps Kubernetes + Google providers with IAP tunnel)",
    "utils.StartTunnel(ctx, resourceData, googleConfig) → proxyURL",
    "utils.CombineSchemas(googleProvider, underlyingProvider, toReplace, replaceWith) → CombinedSchema",
    "utils.WrapSchemaResource(resource) → *schema.Resource",
    "utils.UpdateSchemaWithDefaults(schemaMap) → schemaMap",
    "utils.CombineProtoSchemas(ctx, googleSchema, protoSchema, toReplace, replaceWith) → *tfprotov5.Schema"
  ]
}
